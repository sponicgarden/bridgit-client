<?xml version="1.0" encoding="utf-8"?>
<!-- Informational panel: soft lavender-to-sand gradient, as on the welcome page. Only for text people read,
     never for rows they tap or switch. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="315"
        android:endColor="@color/design_info_end"
        android:startColor="@color/design_info_start" />
    <stroke android:width="1dp" android:color="@color/design_info_edge" />
    <corners android:radius="16dp" />
</shape>
