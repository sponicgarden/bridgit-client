<?xml version="1.0" encoding="utf-8"?>
<!-- Pair a device (owner, 5 Nov 2026): every kind of pairing in one place, in two plain groups — this phone joins
     another, or another device joins this phone. Each card starts the existing pairing flow. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/linkpair_title"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Widget.Bridgit.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:text="@string/linkpair_group_join" />

            <include
                android:id="@+id/joinAsSatellite"
                layout="@layout/pair_option" />

            <include
                android:id="@+id/viewHub"
                layout="@layout/pair_option" />

            <TextView
                style="@style/Widget.Bridgit.SectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingTop="20dp"
                android:text="@string/linkpair_group_host" />

            <!-- One card for every device that joins this phone (owner, 5 Nov 2026): a Bridgit Portal scans this
                 phone's code and joins as a view-only satellite; a Bridgit phone shows its own code, scanned here. -->
            <include
                android:id="@+id/addDevice"
                layout="@layout/pair_option" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:text="@string/portal_relay_note"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
