<?xml version="1.0" encoding="utf-8"?>
<!-- Linked devices (owner, 5 Nov 2026): the map of every hub, portal and satellite linked to this phone (and the
     devices on its network) fills the screen, with one small Pair a device strip below. Tapping a device on the map shows it and what can be done with it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/linked_title"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <!-- Pause pills (owner, 5 Nov 2026; design pass by Sol 6.1): two small pills in the map's panel colour, green outline
         and dot while that side is on, red while paused. Each takes every satellite, or every hub, off the network
         without unlinking. Colours, state and TalkBack come from PortalActivity.pill(). -->
    <LinearLayout
        android:id="@+id/pauseStrip"
        android:baselineAligned="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pauseSatellites"
            style="@style/LinkedPausePill"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/pauseHubs"
            style="@style/LinkedPausePill"
            android:layout_marginStart="4dp" />
    </LinearLayout>


    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <cc.bridgit.app.portal.LinkedDevicesDiagram
        android:id="@+id/diagram"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:focusable="true"
        android:importantForAccessibility="yes" />

    <!-- Legend: the colours and shapes on the map. -->
    <LinearLayout
        android:id="@+id/legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:text="@string/linked_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Pair a device (owner, 5 Nov 2026): a small outlined strip in the page's colours, set apart from the map by its
         edge rather than a block of blue; the three kinds of device it pairs are shown as the map's shapes. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pairCard"
        style="@style/Widget.Material3.CardView.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="20dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/linkpair_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <!-- Hub, Satellite, Portal: icon and name each, filled in by PortalActivity. -->
                <LinearLayout
                    android:id="@+id/pairKinds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:contentDescription="@string/linked_pair_body"
                    android:importantForAccessibility="yes"
                    android:orientation="horizontal" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pairDevice"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/linkpair_title"
                android:minHeight="48dp"
                android:text="@string/linked_pair_button"
                app:icon="@drawable/ic_qr" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
