<?xml version="1.0" encoding="utf-8"?>
<!-- One agent row on the Agents tab (flat, like Applets › Config): brand icon, name, a model line and a status line,
     its pause button, then its permissions summary. A0140: the full name, connection and status always show, so
     every text line wraps instead of ellipsizing. The row opens the agent; the button pauses or resumes it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <cc.bridgit.app.ui.common.AgentAvatarView
            android:id="@+id/avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                style="@style/Widget.Bridgit.AppletTitle"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none" />

            <TextView
                android:id="@+id/connection"
                style="@style/Widget.Bridgit.AppletSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/agents_dot_idle" />

                <TextView
                    android:id="@+id/line2"
                    style="@style/Widget.Bridgit.AppletSecondary"
                    android:layout_width="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pause"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/agents_ic_pause"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- A0115: the agent's permissions in place, "12 of 20", expandable to the full panel with its switches. -->
    <include android:id="@+id/permissions" layout="@layout/permissions_summary_row" />

    <FrameLayout
        android:id="@+id/permissionsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="68dp"
        android:background="?attr/colorOutlineVariant" />
</LinearLayout>
