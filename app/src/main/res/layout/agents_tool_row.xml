<?xml version="1.0" encoding="utf-8"?>
<!-- One external tool on the Agents tab (Jev, Clef, issues, relay...): its name and state, then what it does
     and when the phone last called it. Read-only: the pause for all of them is the switch above. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/agents_dot_idle" />

        <ImageView
            android:id="@+id/logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/name"
            style="@style/Widget.Bridgit.AppletTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/detail"
        style="@style/Widget.Bridgit.AppletSecondary"
        android:layout_marginStart="20dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="2" />
</LinearLayout>
