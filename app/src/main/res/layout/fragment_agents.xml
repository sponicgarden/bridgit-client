<?xml version="1.0" encoding="utf-8"?>
<!-- Agents tab, flat like Applets › Config (design pass 9 Nov 2026, docs/design/agents-redesign): sections with
     headings and plain rows, no panels or nested cards. Agents (pause all, one row per agent, Activity), Devices
     (this device and linked ones), External tools. The setup banner is a title, a count and one button; its
     checklist lives in the Finish setup dialog. The ⋮ menu floats at the top right and hides once scrolled. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Max Agentic Control is off: the one thing to finish, above everything else. -->
                <LinearLayout
                    android:id="@+id/max_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/home_bg_section"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingEnd="32dp">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/design_bg_icon_bolt">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_bolt"
                                app:tint="@color/firstrun_amber" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/max_banner_heading"
                                style="@style/Widget.Bridgit.AppletTitle"
                                android:accessibilityHeading="true"
                                android:text="@string/max_missing_heading" />

                            <TextView
                                android:id="@+id/max_banner_body"
                                style="@style/Widget.Bridgit.AppletSecondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/max_banner_enable"
                        style="?attr/bridgitPillStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/max_missing_continue"
                        app:icon="@drawable/ic_bolt"
                        app:iconGravity="textStart" />
                </LinearLayout>

                <!-- 1. Agents. -->
                <LinearLayout
                    android:id="@+id/agentsPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/agents_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp">

                        <TextView
                            style="@style/Widget.Bridgit.AppletHeading"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:paddingStart="0dp"
                            android:paddingTop="0dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="0dp"
                            android:text="@string/agents_section_list" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/add_agent"
                            style="?attr/bridgitPillTextStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/agents_add"
                            app:icon="@drawable/ic_add" />
                    </LinearLayout>

                    <include android:id="@+id/pauseAgents" layout="@layout/settings_switch_row" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/agents_row" />

                    <TextView
                        android:id="@+id/empty"
                        style="@style/Widget.Bridgit.AppletSecondary"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:text="@string/agents_empty_title"
                        android:visibility="gone" />

                    <!-- What the agents did on this device: opens the Activity log. -->
                    <LinearLayout
                        android:id="@+id/activityRow"
                        style="@style/Widget.Bridgit.AppletRow">

                        <ImageView
                            style="@style/Widget.Bridgit.AppletIcon"
                            android:src="@drawable/ic_nav_activity" />

                        <TextView
                            style="@style/Widget.Bridgit.AppletTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/agents_activity_row" />

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:importantForAccessibility="no"
                            android:padding="12dp"
                            android:src="@drawable/ic_chevron"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. Devices: this device with its profile, then every linked device. -->
                <LinearLayout
                    android:id="@+id/devicesPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.Bridgit.AppletHeading"
                        android:text="@string/agents_section_devices" />

                    <LinearLayout
                        android:id="@+id/devices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Pair, disconnect and trust tiers stay on the Linked devices screen. -->
                    <LinearLayout
                        android:id="@+id/portalRow"
                        style="@style/Widget.Bridgit.AppletRow">

                        <ImageView
                            style="@style/Widget.Bridgit.AppletIcon"
                            android:src="@drawable/ic_computer" />

                        <TextView
                            style="@style/Widget.Bridgit.AppletTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/agents_manage_linked" />

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:importantForAccessibility="no"
                            android:padding="12dp"
                            android:src="@drawable/ic_chevron"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. External tools: one pause for all of them. -->
                <LinearLayout
                    android:id="@+id/toolsPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.Bridgit.AppletHeading"
                        android:text="@string/agents_section_tools" />

                    <include android:id="@+id/pauseExternal" layout="@layout/settings_switch_row" />

                    <LinearLayout
                        android:id="@+id/tools"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- The ⋮ menu (Report a bug) floats at the top right and hides while the list is scrolled down. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="4dp"
        android:background="@android:color/transparent"
        android:minHeight="48dp"
        app:contentInsetStart="0dp" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
