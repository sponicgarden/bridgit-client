<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of an agent's Recent activity (#0003, #0004): a tinted icon for the kind of action,
  the sentence in owner words, a context line, coloured method/status chips and the time.
  Error rows get a red stripe and a red icon circle. Collapsed polls show a count badge.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:minHeight="64dp">

    <View
        android:id="@+id/error_stripe"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="?attr/colorError"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="noHideDescendants">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:background="@drawable/agentact_bg_icon"
                android:padding="9dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/agentact_bg_count"
                android:gravity="center"
                android:minWidth="20dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</FrameLayout>
