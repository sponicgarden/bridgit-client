<?xml version="1.0" encoding="utf-8"?>
<!-- The update dialog's content (UPD-02): logo with a status badge, wordmark and tagline, title, message, version pill,
     optional progress and hint, and a thin countdown bar for messages that close by themselves. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/update_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:scrollbars="vertical">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <!-- Logo + "bridgit" wordmark + tagline (owner rule, 2 Nov 2026: the icon never shows without the wordmark). -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/update_logo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher_round" />

            <ImageView
                android:id="@+id/update_badge"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|end"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:src="@drawable/ic_check" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/update_wordmark"
                android:layout_width="@dimen/brand_tagline_width"
                android:layout_height="@dimen/update_wordmark_height"
                android:contentDescription="@string/app_name"
                android:src="@drawable/brand_wordmark"
                app:tint="?attr/colorOnSurface" />

            <!-- Fit and center each line beneath the wordmark, retaining the bold lead. -->
            <cc.bridgit.app.ui.common.FitWidthTextView
                android:id="@+id/update_tagline"
                android:layout_width="@dimen/brand_tagline_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_horizontal"
                android:text="@string/app_tagline_unlock"
                android:textStyle="bold"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurface" />

            <cc.bridgit.app.ui.common.FitWidthTextView
                android:layout_width="@dimen/brand_tagline_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_horizontal"
                android:text="@string/app_tagline_unleash"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/update_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/update_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- The welcome page's short lavender-to-amber accent line under the lead text. -->
    <View
        style="@style/Widget.Bridgit.Rule"
        android:layout_marginTop="14dp" />

    <TextView
        android:id="@+id/update_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/update_bg_version"
        android:fontFamily="monospace"
        android:paddingStart="14dp"
        android:paddingTop="5dp"
        android:paddingEnd="14dp"
        android:paddingBottom="5dp"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurface" />

    <ImageView
        android:id="@+id/update_install_qr"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/update_install_qr"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/update_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:max="100"
        android:visibility="gone"
        app:indicatorTrackGapSize="0dp"
        app:trackColor="?attr/colorSurfaceContainerHighest"
        app:trackCornerRadius="4dp"
        app:trackStopIndicatorSize="0dp"
        app:trackThickness="6dp" />

    <TextView
        android:id="@+id/update_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/update_countdown"
        android:layout_width="96dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="12dp"
        android:max="1000"
        android:visibility="gone"
        app:indicatorTrackGapSize="0dp"
        app:trackColor="?attr/colorSurfaceContainerHighest"
        app:trackCornerRadius="2dp"
        app:trackStopIndicatorSize="0dp"
        app:trackThickness="4dp" />
</LinearLayout>

</androidx.core.widget.NestedScrollView>
