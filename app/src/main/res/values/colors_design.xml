    <color name="design_info_end">@color/b_surface_container</color>
    <color name="design_info_edge">@color/b_outline_variant</color>
    <color name="design_rule_start">@color/b_primary</color>
    <color name="design_rule_end">@color/b_primary</color>
    <color name="design_screen_glow">@color/b_surface_container_low</color>
</resources>
