    <!-- Always two lines: "Designed for your" / "favorite agent." (owner, 7 Nov 2026). The no-break space keeps "agent." with "favorite". -->
    <string name="firstrun_p1_headline">Designed for your\nfavorite\u00A0agent.</string>
    <string name="firstrun_p1_tagline">Build distributed applications with real-world senses and networked intelligence.</string>
    <string name="firstrun_agent_logos">Control agents and providers</string>
    <string name="firstrun_p1_body">Your AI control agents get a device to work with. They reach it over your private Tailscale network, through a simple API or MCP, and you see every request.</string>
    <string name="firstrun_caps_heading">What Bridgit can do</string>
    <string name="firstrun_caps_body">With these capabilities, your control agent can build amazing applets for you.</string>
    <string name="firstrun_cap_see_title">See</string>
    <string name="firstrun_cap_see_body">Take a photo, a short video or a screenshot.</string>
    <string name="firstrun_cap_hear_title">Hear and speak</string>
    <string name="firstrun_cap_hear_body">Record audio, listen for wake words, and speak out loud.</string>
    <string name="firstrun_cap_files_title">Photos and files</string>
    <string name="firstrun_cap_files_body">Find gallery photos, send files, and receive what you share.</string>
    <string name="firstrun_cap_identify_title">Identify images and sounds</string>
    <string name="firstrun_cap_identify_body">Use AI to understand photos, audio and video.</string>
    <string name="firstrun_cap_context_title">Know where and what</string>
    <string name="firstrun_cap_context_body">Check the weather, location, battery and sensors. Use the flashlight or Find my phone.</string>
    <string name="firstrun_cap_network_title">Connect to devices on your network</string>
    <string name="firstrun_cap_network_body">Reach computers, printers and TVs on your Wi-Fi.</string>
    <string name="firstrun_cap_ask_title">Ask you</string>
    <string name="firstrun_cap_ask_body">Questions, notices and cards you answer with a tap.</string>
    <string name="firstrun_ideas_heading">Things to try</string>
    <string-array name="firstrun_ideas">
        <item>Snap the whiteboard and turn it into notes.</item>
        <item>Tell me if the baby cries.</item>
        <item>Walk me through this neighbourhood.</item>
        <item>Ring my phone, I can\'t find it.</item>
    </string-array>
    <string name="firstrun_p2_title">Private by design.</string>
    <string name="firstrun_p2_body">Keep activity on your device and private network, or set up a backend web portal to view and monitor Bridgit’s activity. Just ask your control agent.</string>
    <string name="firstrun_p3_title">Before you add a control agent</string>
    <string name="firstrun_p3_warning">Each control agent gets a setup text that holds its own key. That text contains a key that gives super-control of your device. Do not give it to any human or silicon intelligence agent you do not trust to have your best interests at heart, and the ability to defend themselves against malicious actors.</string>
    <string name="firstrun_p3_risk">Pasting it into a hosted AI service is your call; you can rotate the key any time from the control agent\'s page.</string>
    <string name="firstrun_p3_body">Every feature starts off. Turn on what you want, and switch anything off in one tap.</string>
