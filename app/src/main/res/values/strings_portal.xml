    <string name="portal_copy">Copy link</string>
    <string name="portal_share">Share</string>
    <string name="portal_done">Done</string>
    <!-- Share: subject and message around the pairing link. %1$s = this phone's name, %2$s = the bridgit.cc/portalpairing page, %3$s = the link. -->
    <string name="portal_share_subject">Pair with %1$s in Bridgit Portal</string>
    <string name="portal_share_text">"You're invited to view %1$s in Bridgit Portal.\n\nThe link at the bottom works once, on one iPhone, iPad or Android phone. It expires in 24 hours if nobody uses it.\n\n\nHOW TO CONNECT\n\n1.  Get the Bridgit Portal app (iPhone, iPad or Android):\n    %2$s\n\n2.  Copy the pairing link at the bottom of this message.\n\n3.  Paste it into the app:\n    •  iPhone or iPad: tap Paste a sign-in or pairing link.\n    •  Android: open Bridgit › More › Linked devices › Pair a device › View another phone\'s Home.\n\n\nYOUR PAIRING LINK\n\n%3$s"</string>
    <string name="portal_copied">Link copied</string>
    <!-- The pairing sheet once the portal has made its first call. %1$s = what it calls itself ("iPhone 16 Pro"), %2$s = phone/tablet. -->
    <string name="portal_connected_body">%1$s can now view this %2$s\'s Home in Bridgit Portal.</string>
    <string name="portal_connected_someone">Your device</string>
    <string name="portal_connected_text">It now shows on Linked devices. Tap it there to disconnect it at any time.</string>
    <string name="portal_disconnect">Disconnect</string>
