    <string name="portal_approve_failed_title">Can\'t approve request</string>
    <string name="portal_failed">Couldn\'t set up the portal: %1$s</string>
    <string name="portal_scan_title">Scan with the Bridgit Portal app</string>
    <string name="portal_scan_body">On the iPhone or iPad, open Bridgit Portal and scan this code. On an Android phone, open Bridgit › More › Linked devices › Pair a device › View another phone\'s Home. Or copy the link and send it. It\'s shown only now. Keep it private: whoever has it can see this phone until you disconnect it here.</string>
