    <string name="portal_disconnect_title">Disconnect %1$s?</string>
    <string name="portal_disconnect_body">The iPhone or iPad paired as %1$s stops seeing this %2$s right away. You can pair it again later.</string>
    <string name="portal_request_title">Bridgit Portal wants to view this phone</string>
    <string name="portal_request_text">%1$s on %2$s asks to see this phone. Tap to allow or deny.</string>
    <string name="portal_request_dialog_title">Allow %1$s to view this %2$s?</string>
    <string name="portal_request_dialog_body">%1$s, signed in as %2$s, asks to see this %3$s through Bridgit Portal: Home, network devices, activity, control agents and applets. It only reads; it can\'t take photos, record, tap or change settings. You can disconnect it here any time.</string>
