    <!-- Linked devices and Pair a device (owner, 5 Nov 2026). -->
    <string name="cap_portal">Bridgit Portal</string>
    <string name="cap_portal_desc">Read-only data for the Bridgit Portal app on your iPhone or iPad: Home, network devices, activity, control agents and applets.</string>
    <string name="portal_title">Bridgit Portal</string>
    <string name="portal_hero_body">The Bridgit Portal app shows this phone\'s Home, network devices, activity, control agents and applets, live. It only reads: it can\'t take photos, record, tap or change settings.</string>
    <string name="portal_pair">Show a pairing code</string>
    <string name="portal_pairing">Setting up…</string>
