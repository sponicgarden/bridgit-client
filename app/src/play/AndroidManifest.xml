<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- ADB control (8.27) is private-build only. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:node="remove" tools:ignore="ProtectedPermissions" />
    <!-- Play updates the Play build; Play policy forbids apps that install their own updates. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" tools:node="remove" />
    <!-- Health Connect, usage access: left out of the Play build (Capability.Registry.PLAY_EXCLUDED). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:node="remove" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.health.READ_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" tools:node="remove" />
    <application>
        <!-- Lint 31.7 reads each source overlay independently; retain the real inherited FGS declaration here too. -->
        <service android:name="cc.bridgit.app.BridgeService" android:foregroundServiceType="camera|microphone|location|mediaPlayback|specialUse" />
        <service android:name="cc.bridgit.app.capability.ScreenshotService" tools:node="remove" />
        <service android:name="cc.bridgit.app.planned.NotificationReaderService" tools:node="remove" />
        <receiver android:name="cc.bridgit.app.adb.AdbPairReceiver" tools:node="remove" />
        <activity android:name="cc.bridgit.app.planned.HealthPrivacyActivity" tools:node="remove" />
        <activity-alias android:name="cc.bridgit.app.planned.HealthPermissionsUsage" tools:node="remove" />
    </application>
</manifest>
