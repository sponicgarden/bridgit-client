{
  "format": "bridgit-template/1",
  "id": "dog-monitor",
  "version": "1.3.0",
  "kind": "applet",
  "name": "Pet monitor",
  "summary": "See observed activity, resting, meals and drinks on one device. The current vision classifier recognizes dogs.",
  "runtime": {
    "adapter": "android.dog.v1",
    "applet_key": "dog",
    "status": "existing_specialized_runtime",
    "supports_dynamic_execution": false
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "camera": {
        "type": "string",
        "enum": [
          "rear",
          "front"
        ]
      },
      "interval_ms": {
        "type": "integer",
        "minimum": 10000,
        "maximum": 3600000
      },
      "timezone": {
        "type": "string",
        "maxLength": 200,
        "format": "timezone"
      },
      "model": {
        "type": "string",
        "enum": [
          "local",
          "jev",
          "clef",
          "openrouter"
        ]
      }
    },
    "required": [
      "camera",
      "interval_ms",
      "timezone",
      "model"
    ],
    "additionalProperties": false
  },
  "defaults": {
    "camera": "rear",
    "interval_ms": 10000,
    "timezone": "UTC",
    "model": "local"
  },
  "permissions": {
    "required": [
      "camera"
    ],
    "optional": [],
    "remote": [
      "per-instance-backend-consent",
      "remote-model-consent"
    ],
    "automatic_grants": false
  }
}
