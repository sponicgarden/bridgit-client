    {
      "openapi": "3.1.0",
      "info": {
        "title": "Bridgit applet recipient history",
        "version": "1.0.0"
      },
      "servers": [
        {
          "url": "https://bridgit-feedback.bridgit-app.workers.dev"
        }
      ],
      "security": [
        {
          "accountSession": []
        }
      ],
      "paths": {
        "/v1/watch/applet/recipients": {
          "get": {
            "operationId": "listAppletRecipients",
            "summary": "Recent remembered recipients for the verified account",
            "parameters": [
              {
                "name": "q",
                "in": "query",
                "schema": {
                  "type": "string",
                  "maxLength": 200
                },
                "description": "Case-insensitive literal substring; most recent 50 matches."
              }
            ],
            "responses": {
              "200": {
                "description": "Only the signed-in account’s remembered sharing and contact relationships.",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "required": [
                        "recipients"
                      ],
                      "properties": {
                        "recipients": {
                          "type": "array",
                          "maxItems": 50,
                          "items": {
                            "type": "object",
                            "required": [
                              "email",
                              "used_at"
                            ],
                            "properties": {
                              "email": {
                                "type": "string",
                                "format": "email",
                                "maxLength": 200
                              },
                              "used_at": {
                                "type": "integer",
                                "description": "Last recorded use, Unix milliseconds."
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "400": {
                "description": "Invalid address, unknown field or conflicting operation."
              },
              "401": {
                "description": "A current session with a verified account email is required."
              },
              "405": {
                "description": "Unsupported method."
              }
            }
          },
          "post": {
            "operationId": "rememberAppletRecipient",
            "summary": "Remember or restore one address without granting access",
            "requestBody": {
              "required": true,
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "required": [
                      "email"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 200
                      }
                    }
                  }
                }
              }
            },
            "responses": {
              "200": {
                "description": "Account-scoped private result. No email is sent and no applet access is granted.",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object"
                    }
                  }
                }
              },
              "400": {
                "description": "Invalid address, unknown field or conflicting operation."
              },
              "401": {
                "description": "A current session with a verified account email is required."
              },
              "405": {
                "description": "Unsupported method."
              }
            }
          },
          "delete": {
            "operationId": "forgetAppletRecipients",
            "summary": "Forget one remembered address or clear this account’s remembered addresses",
            "requestBody": {
              "required": true,
              "content": {
                "application/json": {
                  "schema": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "email"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "email": {
                            "type": "string",
                            "format": "email",
                            "maxLength": 200
                          }
                        }
                      },
                      {
                        "type": "object",
                        "required": [
                          "all"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "all": {
                            "const": true
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "responses": {
              "200": {
                "description": "Account-scoped private result. No email is sent and no applet access is granted.",
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object"
                    }
                  }
                }
              },
              "400": {
                "description": "Invalid address, unknown field or conflicting operation."
              },
              "401": {
                "description": "A current session with a verified account email is required."
              },
              "405": {
                "description": "Unsupported method."
              }
            }
          }
        }
      },
      "components": {
        "securitySchemes": {
          "accountSession": {
            "type": "http",
            "scheme": "bearer",
            "description": "Existing verified Bridgit Google or email account session. Browser cookie sessions use the same path under https://bridgit.cc/api/watch; writes require Origin: https://bridgit.cc."
          }
        }
      },
      "x-configuration-coverage": {
        "recipient_email": "GET reads; POST creates/restores; DELETE removes or clears. Normalized lowercase; same address validation as sharing.",
        "used_at": "Internal runtime timestamp; not user editable.",
        "hidden": "Internal deletion tombstone; prevents forgotten history from being automatically imported again.",
        "sync_and_audit": "Internal synchronization timestamps and mutation audit; not user editable.",
        "sources": [
          "owned-applet sharing and invitation history",
          "accepted incoming applet invitations",
          "existing account-owned Bridgit contact/email interactions"
        ],
        "mailbox_access": false
      }
    },
    {
      "openapi": "3.1.0",
      "info": {
        "title": "Bridgit applet wordmarks",
        "version": "1.2.0"
      },
      "servers": [
        {
          "url": "https://bridgit-feedback.bridgit-app.workers.dev"
        }
      ],
      "security": [
        {
          "accountSession": []
        }
      ],
      "paths": {
        "/v1/watch/applet/wordmark": {
          "get": {
            "operationId": "readAppletWordmark",
            "parameters": [
              {
                "name": "phone",
                "in": "query",
                "required": true,
                "schema": {
                  "type": "string"
                }
              },
              {
                "name": "applet",
                "in": "query",
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            ],
            "description": "Verified portal owners may mutate; owners and accepted shared viewers may read. Current generation and name fence image publication.",
            "responses": {
              "200": {
                "description": "State and name for accepted portal readers. Owner responses also include prompt (effective editable design brief), custom_prompt (saved override or null) and generation_prompt (exact prompt snapshot for the current image/job, null for legacy images). All accepted readers also receive text_only (boolean; default false)."
              },
              "401": {
                "description": "Authentication required"
              },
              "403": {
                "description": "Owner authority required for mutations"
              },
              "404": {
                "description": "Portal or current image unavailable"
              }
            }
          },
          "post": {
            "operationId": "regenerateAppletWordmark",
            "parameters": [
              {
                "name": "phone",
                "in": "query",
                "required": true,
                "schema": {
                  "type": "string"
                }
              },
              {
                "name": "applet",
                "in": "query",
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            ],
            "description": "Owner-only: {prompt: string} saves the applet design brief without a paid call; {prompt: null} restores the palette-specific default. {request_id} regenerates in the background using the saved brief and current applet name. Jobs snapshot the resolved provider prompt. Prompt configuration is private to the owner. {text_only: boolean} saves display preference without deleting the image or generating a replacement. Image readers receive text_only; prompt settings remain owner-only.",
            "responses": {
              "200": {
                "description": "Prompt saved; no generation queued"
              },
              "202": {
                "description": "Queued in background"
              },
              "401": {
                "description": "Authentication required"
              },
              "403": {
                "description": "Owner authority required for mutations"
              },
              "404": {
                "description": "Portal or current image unavailable"
              }
            },
            "requestBody": {
              "required": true,
              "content": {
                "application/json": {
                  "schema": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "request_id"
                        ],
                        "properties": {
                          "request_id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9_-]{8,128}$"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "prompt"
                        ],
                        "properties": {
                          "prompt": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "minLength": 1,
                            "maxLength": 4000,
                            "description": "Design brief, trimmed and nonblank; null restores the default. Newlines allowed; other control characters refused."
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "text_only"
                        ],
                        "properties": {
                          "text_only": {
                            "type": "boolean",
                            "description": "Hide or show the existing wordmark without deleting or regenerating it."
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "delete": {
            "operationId": "clearAppletWordmark",
            "parameters": [
              {
                "name": "phone",
                "in": "query",
                "required": true,
                "schema": {
                  "type": "string"
                }
              },
              {
                "name": "applet",
                "in": "query",
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            ],
            "description": "Verified portal owners may mutate; owners and accepted shared viewers may read. Current generation and name fence image publication.",
            "responses": {
              "200": {
                "description": "Success"
              },
              "401": {
                "description": "Authentication required"
              },
              "403": {
                "description": "Owner authority required for mutations"
              },
              "404": {
                "description": "Portal or current image unavailable"
              }
            }
          }
        },
        "/v1/watch/applet/wordmark/image": {
          "get": {
            "operationId": "readAppletWordmarkImage",
            "parameters": [
              {
                "name": "phone",
                "in": "query",
                "required": true,
                "schema": {
                  "type": "string"
                }
              },
