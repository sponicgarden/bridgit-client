{
  "kind": "html",
  "title": "5 action items from the Q1 planning call",
  "html": "<style>\n*{box-sizing:border-box}\nbody{margin:0;background:#f4f6f8;color:#1e293b;font:16px/1.45 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;min-height:100vh}\n.wrap{max-width:520px;margin:0 auto;padding:20px 18px 28px}\n.eyebrow{font-size:13px;font-weight:600;color:#0f766e;letter-spacing:.04em;text-transform:uppercase;margin:0 0 6px}\nh1{font-size:22px;line-height:1.25;margin:0 0 10px;letter-spacing:-.01em}\n.meta{display:flex;align-items:center;gap:10px;color:#475569;font-size:14px;margin-bottom:18px;flex-wrap:wrap}\n.avs{display:flex}\n.av{width:32px;height:32px;border-radius:50%;display:grid;place-content:center;font-size:11px;font-weight:700;border:2px solid #f4f6f8;margin-left:-6px;color:#1e293b}\n.av:first-child{margin-left:0}\n.count{display:flex;gap:8px;margin-bottom:12px;font-size:14px;font-variant-numeric:tabular-nums}\n.count span{background:#fff;border-radius:999px;padding:6px 12px;box-shadow:0 1px 2px rgba(15,23,42,.06);color:#475569}\n.count b{color:#1e293b}\n.count .you b{color:#0f766e}\n.list{display:flex;flex-direction:column;gap:10px;margin-bottom:20px}\n.item{background:#fff;border-radius:16px;padding:14px 14px 12px;display:grid;grid-template-columns:48px 1fr;gap:4px 10px;box-shadow:0 1px 3px rgba(15,23,42,.06),0 4px 14px rgba(15,23,42,.04);border:1.5px solid transparent;transition:border-color .18s,background .18s,opacity .18s}\n.item.mine{border-color:#99e0dc;background:#f0fbfa}\n.item.off{opacity:.55}\n.tick{grid-row:1/3;width:48px;height:48px;border:0;background:none;padding:0;cursor:pointer;display:grid;place-content:center}\n.tick i{width:26px;height:26px;border-radius:8px;border:2px solid #cbd5e1;display:grid;place-content:center;transition:all .18s;color:#fff;font-style:normal;font-size:15px;font-weight:800}\n.tick.on i{background:#0ea5a4;border-color:#0ea5a4}\n.task{font-size:15.5px;font-weight:550;padding-top:2px}\n.item.off .task{text-decoration:line-through}\n.chips{display:flex;gap:8px;flex-wrap:wrap}\n.chip{font:inherit;font-size:13.5px;font-weight:600;border:1px solid #e2e8f0;background:#f8fafc;color:#334155;border-radius:999px;padding:0 14px;min-height:48px;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:background .15s,border-color .15s,transform .1s}\n.chip.own.me{background:#0f766e;border-color:#0f766e;color:#fff}\n.chip small{font-size:12px;opacity:.75;font-weight:500}\n.chip:active,.main:active{transform:scale(.98)}\n.main{width:100%;font:inherit;font-weight:700;border:0;border-radius:14px;min-height:54px;background:#0f766e;color:#fff;cursor:pointer;box-shadow:0 6px 18px rgba(14,165,164,.28);transition:background .15s,transform .1s}\n.main:disabled{background:#94a3b8;box-shadow:none;cursor:default}\n.alt{width:100%;font:inherit;font-weight:600;border:0;background:none;color:#475569;min-height:48px;margin-top:6px;cursor:pointer}\n.status{text-align:center;color:#475569;font-size:14px;min-height:20px;margin-top:8px}\n.done{color:#0f766e}\n</style>\n<div class=\"wrap\">\n  <p class=\"eyebrow\" id=\"eyebrow\"></p>\n  <h1 id=\"title\"></h1>\n  <div class=\"meta\"><div class=\"avs\" id=\"avs\"></div><span id=\"when\"></span></div>\n  <div class=\"count\"><span class=\"you\"><b id=\"nYou\">0</b> for you</span><span><b id=\"nOther\">0</b> for others</span></div>\n  <div class=\"list\" id=\"list\"></div>\n  <button class=\"main\" id=\"send\"></button>\n  <button class=\"alt\" id=\"later\"></button>\n  <div class=\"status\" id=\"status\"></div>\n</div>\n<script>\n// answer.data: {action:\"send\"|\"later\", items:[{id, task, accepted, owner:\"you\"|\"maja\"|…, due:\"2026-11-06\"|null}]}\n// The card's content. Change only this object.\nvar CARD = {\n  eyebrow: 'Action items',\n  title: 'Q1 planning call',\n  when: 'Tue 3 Nov · 45 min · 6 people',\n  attendees: [\n    {id:'you', name:'You', initials:'Me', colour:'#99f6e4'},\n    {id:'maja', name:'Maja', initials:'MK', colour:'#fde68a'},\n    {id:'tomasz', name:'Tomasz', initials:'TW', colour:'#c7d2fe'},\n    {id:'ines', name:'Ines', initials:'IR', colour:'#fbcfe8'},\n    {id:'piotr', initials:'PN', colour:'#bbf7d0'},\n    {id:'lea', initials:'LB', colour:'#fed7aa'}\n  ],\n  owners: ['you','maja','tomasz','ines'],\n  dues: [\n    {label:'Fri', date:'2026-11-06'},\n    {label:'Next Mon', date:'2026-11-09'},\n    {label:'Next Fri', date:'2026-11-13'},\n    {label:'No date', date:null}\n  ],\n  items: [\n    {id:'a1', task:'Draft the Q1 budget for the Kraków office', owner:'you', due:0},\n    {id:'a2', task:'Book the venue for the January offsite', owner:'maja', due:2},\n    {id:'a3', task:'Share the hiring plan with finance', owner:'you', due:1},\n    {id:'a4', task:'Update the product roadmap slides', owner:'tomasz', due:2},\n    {id:'a5', task:'Send meeting notes to the Lisbon team', owner:'you', due:0}\n  ],\n  sendLabel: 'Send to the team',\n  laterLabel: 'Edit later',\n  sending: 'Sending…',\n  doneText: {send:'Sent to the team', later:'Saved, edit them later'},\n  preview: 'Preview only: open this card in Bridgit to answer.'\n};\nvar $ = function(id){return document.getElementById(id)};\nvar sent = false, rows = [], last = 'send';\nvar people = {}; CARD.attendees.forEach(function(a){people[a.id]=a});\n$('eyebrow').textContent = CARD.eyebrow;\n$('title').textContent = CARD.title;\n$('when').textContent = CARD.when;\n$('later').textContent = CARD.laterLabel;\nCARD.attendees.forEach(function(a){var d=document.createElement('div');d.className='av';d.style.background=a.colour;d.textContent=a.initials;$('avs').appendChild(d)});\nCARD.items.forEach(function(it){\n  var st = {id:it.id, task:it.task, accepted:true, owner:CARD.owners.indexOf(it.owner), due:it.due};\n  var row = document.createElement('div'); row.className='item';\n  var tick = document.createElement('button'); tick.className='tick on'; tick.setAttribute('aria-label','Accept');\n  var box = document.createElement('i'); box.textContent='✓'; tick.appendChild(box);\n  var task = document.createElement('div'); task.className='task'; task.textContent=it.task;\n  var chips = document.createElement('div'); chips.className='chips';\n  var own = document.createElement('button'); own.className='chip own';\n  var due = document.createElement('button'); due.className='chip';\n  chips.appendChild(own); chips.appendChild(due);\n  row.appendChild(tick); row.appendChild(task); row.appendChild(chips);\n  $('list').appendChild(row);\n  st.el = {row:row, tick:tick, box:box, own:own, due:due};\n  tick.onclick = function(){if(sent)return;st.accepted=!st.accepted;draw()};\n  own.onclick = function(){if(sent)return;st.owner=(st.owner+1)%CARD.owners.length;draw()};\n  due.onclick = function(){if(sent)return;st.due=(st.due+1)%CARD.dues.length;draw()};\n  rows.push(st);\n});\nfunction draw(){\n  var you=0, other=0;\n  rows.forEach(function(st){\n    var oid = CARD.owners[st.owner], mine = oid==='you';\n    st.el.row.classList.toggle('mine', mine && st.accepted);\n    st.el.row.classList.toggle('off', !st.accepted);\n    st.el.tick.classList.toggle('on', st.accepted);\n    st.el.box.textContent = st.accepted ? '✓' : '';\n    st.el.own.classList.toggle('me', mine);\n    st.el.own.textContent = people[oid].name;\n    st.el.due.textContent = '';\n    var s = document.createElement('small'); s.textContent='Due'; st.el.due.appendChild(s);\n    st.el.due.appendChild(document.createTextNode(CARD.dues[st.due].label));\n    if (st.accepted) { if (mine) you++; else other++; }\n  });\n  $('nYou').textContent = you; $('nOther').textContent = other;\n  var n = you + other;\n  $('send').disabled = n === 0;\n  $('send').textContent = n ? CARD.sendLabel + ' · ' + n + (n === 1 ? ' item' : ' items') : 'Accept at least one item';\n}\ndraw();\nfunction answer(action){\n  if (sent) return;\n  var b = window.Bridgit || window.Bridget;\n  if (!b) { $('status').textContent = CARD.preview; return; }\n  sent = true; last = action;\n  document.querySelectorAll('button').forEach(function(x){x.disabled=true});\n  $('status').textContent = CARD.sending;\n  b.respond(JSON.stringify({action:action, items:rows.map(function(st){return {id:st.id, task:st.task, accepted:st.accepted, owner:CARD.owners[st.owner], due:CARD.dues[st.due].date}})}));\n}\n$('send').onclick = function(){answer('send')};\n$('later').onclick = function(){answer('later')};\ndocument.addEventListener('bridgit:answered', function(e){\n  e.preventDefault();\n  $('title').textContent = '✓ ' + CARD.doneText[last];\n  $('title').className = 'done';\n  $('status').textContent = '';\n  setTimeout(function(){$('title').scrollIntoView({block:'center'})}, 400);\n});\n</script>\n",
  "expires_in_seconds": 86400
}
