{
  "schema": "bridgit-services/1",
  "model_preferences": "/v1/services/models",
  "budgets": "/v1/services/budgets",
  "scope": "Any installed applet or control agent may select these services through its granted APIs. Discovery grants no access and makes no paid call.",
  "flow_authoring": {
    "ask_model": {
      "result": "answers.<question-id> holds the typed answer. See decisions.md for choice, score and probability representations.",
      "max_questions": 10,
      "apple_prerequisites": "Linked owner, network, monetary budget and consent to each submission. Use a paired Android host for sound watches.",
      "failure": "An unavailable model, missing grant or exhausted budget stops a step under the default error policy. Inspect the run error and honor its retry policy. No implicit model substitution.",
      "android": [
        "clef",
        "jev",
        "glm"
      ],
      "request_schema": "workflow-step.schema.json",
      "max_paid_steps_per_run": 4,
      "max_paid_per_day": 500,
      "macos_foreground": ["clef"],
      "apple_question_types": [
        "choice",
        "score",
        "noul"
      ],
      "privacy": "The hosted model receives the declared questions, state and referenced photo. Declare the transfer in permissions.remote and enable data_policy.device_only.remote_models.",
      "ios_foreground": ["clef"]
    },
    "signed_editions": {
      "reference": "workflow-steps.md describes host support, output fields, edition proof and the data sent for each operation.",
      "appraise.signed-edition-budget.v2": ["appraise"],
      "chef.signed-edition-budget.v2": [
        "scan",
        "observe"
      ]
    }
  },
