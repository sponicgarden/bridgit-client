  {
   "summary": "Your own records on the phone, in key order with their values, about 48 KB a page (pass next as after for the next page)",
   "path": "/v1/applet/records",
   "method": "GET",
   "documentation": "https://bridgit.cc/learn/operations/get-v1-applet-records.json",
   "operation_url": "https://bridgit.cc/learn/operations/get-v1-applet-records.json",
   "control_scope": null,
   "requires_power": null,
   "tool": "applet_records_list"
  },
  {
   "summary": "One of your records",
   "path": "/v1/applet/records/{key}",
   "method": "GET",
   "documentation": "https://bridgit.cc/learn/operations/get-v1-applet-records-key.json",
   "operation_url": "https://bridgit.cc/learn/operations/get-v1-applet-records-key.json",
   "control_scope": null,
   "requires_power": null,
   "tool": "applet_records_get"
  },
  {
   "summary": "Save a control agent record (replaces it). Applet execution principals must use declared processing.tables, including described json columns; this legacy store refuses applet writes",
   "path": "/v1/applet/records/{key}",
   "method": "POST",
   "documentation": "https://bridgit.cc/learn/operations/post-v1-applet-records-key.json",
   "operation_url": "https://bridgit.cc/learn/operations/post-v1-applet-records-key.json",
   "control_scope": null,
   "requires_power": null,
   "tool": "applet_records_save"
  },
  {
   "summary": "Delete one of your records (no error if it's already gone)",
   "path": "/v1/applet/records/{key}",
   "method": "DELETE",
   "documentation": "https://bridgit.cc/learn/operations/delete-v1-applet-records-key.json",
   "operation_url": "https://bridgit.cc/learn/operations/delete-v1-applet-records-key.json",
   "control_scope": null,
   "requires_power": null,
   "tool": "applet_records_delete"
  },
  {
   "summary": "From an installed applet's card: send one result to the applet's private web portal (the kind its package declares in ui.portal.records, e.g. a workout). Words and numbers only, never free text or pictures; it goes only while the owner has the applet's web portal on",
   "path": "/v1/applet/portal/record",
   "method": "POST",
   "documentation": "https://bridgit.cc/learn/operations/post-v1-applet-portal-record.json",
   "operation_url": "https://bridgit.cc/learn/operations/post-v1-applet-portal-record.json",
   "control_scope": null,
   "requires_power": null,
   "tool": "applet_portal_record"
  },
  {
   "summary": "From an installed applet's own card: discover only its declared tables, typed columns and descriptions. Control agents inspect applets with /applets/installed/{id}/data",
   "path": "/v1/applet/tables",
   "method": "GET",
   "documentation": "https://bridgit.cc/learn/operations/get-v1-applet-tables.json",
   "operation_url": "https://bridgit.cc/learn/operations/get-v1-applet-tables.json",
   "control_scope": null,
   "requires_power": null,
   "tool": "applet_tables"
  },
  {
   "summary": "Read this applet principal's own declared table, oldest first. No instance id or installer sharing needed; other applets are inaccessible",
   "path": "/v1/applet/tables/{table}/rows",
   "method": "GET",
   "documentation": "https://bridgit.cc/learn/operations/get-v1-applet-tables-table-rows.json",
   "operation_url": "https://bridgit.cc/learn/operations/get-v1-applet-tables-table-rows.json",
   "control_scope": null,
   "requires_power": null,
   "tool": "applet_tables_rows_get"
  },
  {
