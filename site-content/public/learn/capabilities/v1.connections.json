   "method": "POST",
   "documentation": "https://bridgit.cc/learn/operations/post-v1-connections-configure.json",
   "operation_url": "https://bridgit.cc/learn/operations/post-v1-connections-configure.json",
   "control_scope": null,
   "requires_power": null,
   "tool": "connections_configure"
  },
  {
