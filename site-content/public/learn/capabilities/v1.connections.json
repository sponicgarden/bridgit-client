   "operation_url": "https://bridgit.cc/learn/operations/get-v1-connections.json",
   "control_scope": null,
   "requires_power": null,
   "tool": "connections_get"
  },
  {
   "summary": "Send a message, data and optionally a kept photo to one of the owner's connections. Queued and retried by default; wait_reply waits up to 15 s and returns the reply",
