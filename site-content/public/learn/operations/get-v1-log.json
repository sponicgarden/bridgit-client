 "source": "Endpoints.all + Learn.endpoints + McpTools",
 "operation": {
  "summary": "Read the log; with order=asc&since=<id>&wait=55 it follows new entries",
  "method": "GET",
  "auth": true,
  "mcp_tool": "log_read",
  "query": [
   {
    "name": "channel",
    "description": "Comma list of audit, diagnostic, agent",
    "type": "string",
    "required": false
   },
   {
    "name": "agent",
    "description": "Agent name or id; `me` for you; `bridgit` for Bridgit's own entries",
    "type": "string",
    "required": false
   },
   {
    "name": "kind",
    "description": "request, setting, agent, pairing, service, note, \u2026",
    "type": "string",
    "required": false
   },
   {
    "name": "endpoint",
    "description": "Endpoint prefix, e.g. /v1/camera",
    "type": "string",
    "required": false
   },
   {
    "name": "result",
    "description": "ok, error, or an error code",
    "type": "string",
    "required": false
   },
   {
    "name": "level",
    "description": "Minimum level: debug, info, warn, error",
    "type": "string",
    "required": false
   },
   {
    "name": "since",
    "description": "Log id or ISO time (exclusive id)",
    "type": "string",
    "required": false
   },
   {
    "name": "until",
    "description": "Log id or ISO time",
    "type": "string",
    "required": false
   },
   {
    "name": "q",
    "description": "Text in message or endpoint",
    "type": "string",
    "required": false
   },
   {
    "name": "limit",
    "description": "1-500, default 100",
    "type": "integer",
    "required": false
   },
   {
    "name": "order",
    "description": "desc (default) or asc",
    "type": "string",
    "required": false,
    "enum": [
     "desc",
     "asc"
    ]
   },
   {
    "name": "cursor",
    "description": "next_cursor from the previous page",
    "type": "string",
    "required": false
   },
   {
    "name": "wait",
    "description": "Tail mode: hold up to this many seconds (max 55) for a new entry",
    "type": "integer",
    "required": false
   }
  ],
  "control_scope": null,
