 "operation": {
  "summary": "Deprecated: the old address of POST /v1/issues/{id}/followup, same behaviour",
  "method": "POST",
  "auth": true,
  "mcp_tool": null,
  "query": [],
  "control_scope": null,
  "developer_only": false,
  "capture": false,
  "body": [
   {
    "name": "note",
    "description": "What you see now (500 chars); needed when there's no outcome",
    "type": "string",
    "required": false
   },
   {
    "name": "outcome",
    "description": "works or still_broken: the owner's Confirm / Still broken, allowed once the issue is fixed, wont_fix or duplicate",
    "type": "string",
    "required": false,
    "enum": [
     "works",
     "still_broken"
    ]
   }
  ],
  "example": "POST /v1/feedback/7/followup {\"outcome\":\"still_broken\",\"note\":\"Still returns 500 on 1.7.2\"}",
  "idempotent": true,
  "path": "/v1/feedback/{id}/followup",
  "capability": "feedback",
  "returns": "the issue summary",
  "errors": [
   "not_found",
   "invalid_parameter",
   "rate_limited"
  ],
  "requires": null
 }
}
