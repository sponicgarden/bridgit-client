  "mcp_tool": "lan_cameras_audio_record",
  "query": [],
  "control_scope": null,
  "developer_only": false,
  "capture": true,
  "body": [
   {
    "name": "camera",
    "description": "Enrolled camera id",
    "type": "string",
    "required": true
   },
   {
    "name": "duration_seconds",
    "description": "1..30 whole seconds",
    "type": "integer",
    "required": true
   },
   {
    "name": "raw",
    "description": "1 returns WAV bytes",
    "type": "integer",
    "required": false
   },
   {
    "name": "store",
    "description": "memory, files or upload subject to owner capture policy",
    "type": "array",
    "required": false
   }
  ],
