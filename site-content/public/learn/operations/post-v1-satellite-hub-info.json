  "method": "POST",
  "auth": true,
  "mcp_tool": "satellite_hub_info",
  "query": [],
  "control_scope": null,
  "developer_only": false,
  "capture": false,
  "body": [
   {
    "name": "name",
    "description": "The hub's name",
    "type": "string",
    "required": false
   },
   {
    "name": "device_type",
    "description": "The hub's kind: phone, tablet, computer, tv, watch or camera",
    "type": "string",
    "required": false
   },
   {
    "name": "port",
    "description": "The hub's API port",
    "type": "integer",
    "required": true
   },
   {
    "name": "key",
    "description": "The satellite's return key on the hub",
    "type": "string",
    "required": true
   },
   {
