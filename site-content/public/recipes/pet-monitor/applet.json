{
  "format": "bridgit-template/1",
  "id": "pet-monitor",
  "version": "3.1.2",
  "kind": "applet",
  "name": "Pet activity monitor",
  "summary": "A photo-based activity tally with explicit gaps, a dinner check, and an offline card.",
  "runtime": {
    "adapter": "bridgit.package.v1",
    "applet_key": "pet-monitor",
    "supports_dynamic_execution": false
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "camera",
      "interval_s",
      "max_paid_per_hour"
    ],
    "properties": {
      "camera": {
        "type": "string",
        "enum": [
          "rear",
          "front"
        ]
      },
      "interval_s": {
        "type": "integer",
        "minimum": 30,
        "maximum": 3600
      },
      "max_paid_per_hour": {
        "type": "integer",
        "minimum": 1,
        "maximum": 60
      }
    }
  },
  "defaults": {
    "camera": "rear",
    "interval_s": 30,
    "max_paid_per_hour": 10
  },
  "processing": {
    "watches": [
      {
        "id": "main",
        "request": {
          "label": "Pet activity samples",
          "data": [
            "camera"
          ],
          "camera": {
            "$input": "camera"
          },
          "questions": {
            "pet": {
              "type": "noul",
              "instructions": "Is an animal visible in this photo?"
            },
            "activity": {
              "type": "choice",
              "instructions": "Classify only the visible animal in this photo. If absent or ambiguous choose unclear. Do not infer identity or health.",
              "criteria": {
                "resting": "An animal is lying still.",
                "eating": "An animal visibly eats at a bowl.",
                "drinking": "An animal visibly drinks at a bowl.",
                "other": "Visible activity fits none of those.",
                "unclear": "Absent, occluded or uncertain."
              }
            }
          },
          "model": "clef",
          "interval_s": {
            "$input": "interval_s"
          },
          "window": 1,
          "min_readings": 1,
          "expires_in_s": 604800,
          "repeat": true,
          "local": {
            "change_check": true,
            "sensitivity": "high",
            "learn_noise": true,
            "max_reuse_s": 900
          },
          "max_paid_per_hour": {
            "$input": "max_paid_per_hour"
          },
          "tally": {
            "track": "activity",
            "labels": [
              "resting",
              "eating",
              "drinking",
              "other"
            ],
            "min_confidence": 0.8,
            "keep_days": 30,
            "seen": {
              "answer": "pet",
              "min": 0.6
            }
          },
          "rules": [
            {
              "id": "no-meal-by-6pm",
              "when": {
                "fewer_than": 1,
                "of": "eating",
                "by": "18:00"
              },
              "do": {
                "flow": {
                  "$flow": "dinner"
                }
              }
            }
          ]
        }
      }
    ],
    "flows": [
      {
        "id": "dinner",
        "name": "Dinner check",
        "trigger": {
          "type": "called"
        },
        "max_paid_per_day": 10,
        "steps": [
          {
            "id": "shot",
            "type": "photo",
            "camera": {
              "$input": "camera"
            }
          },
          {
            "id": "look",
            "type": "ask_model",
            "model": "clef",
            "photo": {
              "$step": "shot.photo"
            },
            "questions": {
              "bowl": {
                "type": "choice",
                "instructions": "Look only at the pet's food bowl.",
                "criteria": {
                  "full": "The bowl is clearly full or nearly full.",
                  "eaten": "The bowl is empty or clearly eaten from.",
                  "not_visible": "No food bowl can be seen."
                }
              }
            }
          },
          {
            "type": "notice",
            "only_if": {
              "step": "look.answers.bowl",
              "is": "full"
            },
            "title": "No meal yet",
            "text": [
              {
                "$trigger": "message"
              },
              " The bowl still looks full."
            ]
          },
          {
            "type": "notice",
            "only_if": {
              "step": "look.answers.bowl",
              "is": "eaten"
            },
            "title": "Bowl looks eaten from",
            "text": "No meal was seen on camera, but the bowl looks eaten from. It may have eaten out of view."
          },
          {
            "type": "notice",
            "only_if": {
              "step": "look.answers.bowl",
              "is": "not_visible"
            },
            "title": "Can't see the bowl",
            "text": "No meal seen, and the bowl isn't in the picture. Point the camera at it to check."
          }
        ]
      },
      {
        "id": "review",
        "name": "Check pet activity",
        "trigger": {
          "type": "called"
        },
        "max_paid_per_day": 10,
        "steps": [
          {
            "id": "shot",
            "type": "photo",
            "camera": {
              "$input": "camera"
            }
          },
          {
            "id": "classify",
            "type": "ask_model",
            "model": "clef",
            "photo": {
              "$step": "shot.photo"
            },
            "questions": {
              "activity": {
                "type": "choice",
                "instructions": "Classify the visible pet activity in this photo. Choose unclear when there is no visible animal or its activity is uncertain. Describe visible behavior only.",
                "criteria": {
                  "resting": "An animal is lying still.",
                  "eating": "An animal visibly eats at a bowl.",
                  "drinking": "An animal visibly drinks at a bowl.",
                  "other": "Visible activity fits none of those.",
                  "unclear": "Absent, occluded or uncertain.",
                  "playing": "Visible play with an object, person or another animal.",
                  "moving": "Standing, walking or running."
                }
              }
            }
          },
          {
            "id": "save",
            "type": "record",
            "table": "checks",
            "row": {
              "activity": {
                "$step": "classify.answers.activity"
              }
            }
          },
          {
            "type": "notice",
            "title": "Pet activity",
            "text": [
              "Observed activity: ",
              {
                "$step": "classify.answers.activity"
              }
            ]
          }
        ]
      }
    ],
    "tables": [
      {
        "id": "checks",
        "label": "Owner checks",
        "keep_days": 30,
        "max_rows": 500,
        "share_with_installer": false,
        "columns": {
          "activity": {
            "type": "choice",
            "options": [
              "resting",
              "eating",
              "drinking",
              "other",
              "unclear",
              "playing",
              "moving"
            ]
          }
        }
      }
    ]
  },
  "permissions": {
    "required": [
      "camera",
      "camera.snapshot",
      "decisions",
      "interactions",
      "watches",
      "workflows"
    ],
    "optional": [],
    "remote": [
      "The scheduled activity watch and owner-started checks send camera photos and package questions to Clef for paid classification."
    ],
    "automatic_grants": false
  },
  "ui": {
    "inputs": {
      "camera": {
        "label": "Camera",
        "help": "The phone camera that faces the pet's spot and its bowl."
      },
      "interval_s": {
        "label": "Seconds between photos",
        "help": "30 to 3600. Longer means fewer paid checks."
      },
      "max_paid_per_hour": {
        "label": "Paid photo checks an hour, at most",
        "help": "Unchanged pictures reuse the last answer for free."
      }
    },
    "card": {
      "title": "Pet activity monitor",
      "sources": {
        "activity": {
          "watch": {
            "$watch": "main"
          },
          "read": "tally"
        },
        "last_check": {
          "runs": "workflow",
          "step": "look"
        },
        "owner_checks": {
          "table": "checks",
          "limit": 10
        }
      },
      "fresh_s": 120,
      "states": {
        "empty": "No visible activity samples yet. Gaps and absence are unknown."
      },
      "pieces": [
        {
          "type": "header",
          "eyebrow": "Bridgit applet",
          "text": "A little window into your pet's day."
        },
        {
          "type": "metrics",
          "items": [
            {
              "label": "Observed minutes",
              "value": {
                "$source": "activity.today.watched_minutes"
              },
              "format": "minutes"
            },
            {
              "label": "Readings",
              "value": {
                "$source": "activity.today.checks"
              },
              "format": "number"
            },
            {
              "label": "Bowl at last check",
              "value": {
                "$source": "last_check.answers.bowl"
              },
              "format": "words",
              "words": {
                "full": "Full",
                "eaten": "Eaten from",
                "not_visible": "Not in view"
              },
              "empty": "Not checked"
            }
          ]
        },
        {
          "type": "table",
          "rows": {
            "$source": "activity.today.labels"
          },
          "columns": [
            {
              "key": "$key",
              "label": "Activity"
            },
            {
              "key": "episodes",
              "label": "Episodes",
              "format": "number"
            },
            {
              "key": "minutes",
              "label": "Minutes",
              "format": "number"
            }
          ],
          "empty": "Nothing counted yet today."
        },
        {
          "type": "timeline",
          "items": {
            "$source": "activity.episodes"
          },
          "time": "start",
          "label": "label",
          "detail": "minutes",
          "limit": 5,
          "empty": "No episodes yet. Missing coverage is unknown."
        },
        {
          "type": "note",
          "text": "Sampled observations, not continuous coverage. Gaps and absence are unknown."
        },
        {
          "type": "timeline",
          "items": {
            "$source": "owner_checks.items"
          },
          "time": "at",
          "label": "activity",
          "label_words": {
            "resting": "Resting",
            "eating": "Eating",
            "drinking": "Drinking",
            "playing": "Playing",
            "moving": "Moving",
            "other": "Other activity",
            "unclear": "Unclear"
          },
          "limit": 10,
          "empty": "No owner checks yet."
        },
        {
          "type": "buttons",
          "items": [
            {
              "label": "Check pet activity",
              "do": {
                "flow": {
                  "$flow": "review"
                }
              }
            },
            {
              "label": "Check bowl now",
              "style": "primary",
              "do": {
                "flow": {
                  "$flow": "dinner"
                }
              }
            },
            {
              "label": "Refresh",
              "do": {
                "refresh": true
              }
            },
            {
              "label": "Pause",
              "do": {
                "pause_applet": true
              }
            }
          ]
        }
      ]
    }
  },
  "migration": {
    "strategy": "explicit_owner_opt_in",
    "from": "3.1.1",
    "rules": [],
    "rollback": "Reinstall an earlier approved revision."
  },
  "budget": {
    "day_usd": 1,
    "month_usd": 10
  },
  "data_policy": {
    "backend_default": "device_only",
    "scope": [
      "device_id",
      "applet_instance_id"
    ],
    "device_only": {
      "server_registration": false,
      "uploads": false,
      "remote_models": true,
      "derived_telemetry": false,
      "queue": false
    },
    "enable": "Approve the camera and hosted decisions before starting the watch or a foreground check.",
    "disable": "Pause the applet or revoke hosted decisions to stop checks.",
    "sharing": {
      "role": "none"
    },
    "retention": {
      "local": "Foreground checks retain the activity label for up to 30 days and 500 rows. The review flow does not keep its photo. The scheduled tally covers observed samples and gaps.",
      "server": "Clef receives the image and questions. Bridgit logs service usage and cost metadata."
    },
    "execution": "A scheduled watch tallies observations on supported hosts. The owner can also run one photo check from the card."
  }
}
