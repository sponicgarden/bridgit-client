  "card": {
    "mode": "watch",
    "refresh_label": "Read activity history",
    "read_suffix": "/tally",
    "freshness_seconds": 120,
    "empty": "No visible activity samples yet. Gaps and absence are unknown coverage.",
    "owner_intro": "A little window into your pet’s day.",
    "owner_note": "Sampled observations, not continuous coverage. Gaps and absence are unknown."
  },
  "evidence": [
    "app/src/main/java/cc/bridgit/app/api/Endpoints.kt",
