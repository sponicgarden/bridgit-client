            "change_check": true
          },
          "spec": {
            "interval_s": 20,
            "question": null,
            "data": [
              "camera"
            ],
            "expires_in_s": 7776000,
            "questions": {
              "pot_boiling_over": {
                "instructions": "Is a pot or pan on the stove boiling over, with liquid or foam spilling over its rim? Judge from the newest photo: how likely is it that this is happening in it now?",
                "type": "noul"
              }
            },
            "paid_calls_per_hour_at_most": 30,
            "label": "Pot boiling over",
            "min_readings": 1,
            "max_paid_per_hour": 30,
            "local": {
              "max_reuse_s": 300,
              "learn_noise": true,
              "sensitivity": "normal",
              "change_check": true
            },
            "callback_url": null,
            "cooldown_s": 600,
            "repeat": true,
            "context": null,
            "model": "clef",
            "window": 1,
            "callback_when": [],
