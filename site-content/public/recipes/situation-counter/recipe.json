                      "text": "Seen on the camera just now.",
                      "title": "Pot boiling over",
                      "priority": "urgent"
                    }
                  },
                  "when": {
                    "of": "pot_boiling_over",
                    "within_s": 120,
                    "at_least": 1
                  }
                }
              ],
              "track": "pot_boiling_over",
              "seen": null,
              "labels": null,
              "keep_days": 30
            },
            "situation": "pot_boiling_over"
          },
          "tally_today": null,
          "rules_fired": 0,
          "callback_secret": null,
          "first_check_in_s": 0,
          "delivery": "watch.matched and watch.ended go to your registered callback if you have one, and to GET /v1/events (both need the interactions permission); watch.rule (a rule fired) goes the same way"
        }
      },
      "evidence": "Synthetic contract fixture, not a device observation."
    },
