    "refresh_label": "Record 10 seconds",
    "freshness_seconds": 300,
    "empty": "No recording yet. Tap only when ready to speak.",
    "owner_intro": "Catch a thought before it slips away.",
    "owner_note": "Records ten seconds only when you tap. Review the words before requesting a save."
