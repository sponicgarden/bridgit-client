      "id": "record",
      "request": {
        "method": "POST",
        "path": "/v1/mic/record",
        "body": {
          "duration_seconds": 10,
          "transcribe": true,
          "return_audio": false,
          "language": "en-US",
          "store": []
        }
      },
      "response": {
        "status": 200,
        "body": {
          "recorded_at": "2026-11-04T10:00:00Z",
          "duration_seconds": 10,
          "format": "m4a",
          "sample_rate_hz": 44100,
          "size_bytes": 81200,
          "transcript": "Buy oats on the way home.",
          "on_device": true
        }
      },
      "evidence": "Synthetic contract fixture, not a device observation."
    }
  ],
  "card": {
